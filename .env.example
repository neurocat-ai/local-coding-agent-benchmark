# Network ports are bound to localhost by default. Use an SSH tunnel remotely.
OLLAMA_PORT=11434
OPENHANDS_PORT=8000
POSTGRES_PORT=5432

# Both models stay on disk, but only one is loaded into VRAM at a time.
QWEN_MODEL_SOURCE=qwen3.6:35b-a3b-mtp-q8_0
QWEN_MODEL_PROFILE=qwen36-q8
QWEN_Q4_MODEL_SOURCE=qwen3.6:35b-a3b-q4_K_M
QWEN_Q4_MODEL_PROFILE=qwen36-q4
QWEN_CODING_Q4_MODEL_SOURCE=qwen3.6:35b-a3b-coding-mtp-q4_K_M
QWEN_CODING_Q4_MODEL_PROFILE=qwen36-coding-q4
GPTOSS_MODEL_SOURCE=gpt-oss:120b
GPTOSS_MODEL_PROFILE=gpt-oss-120b
GPTOSS_LITE_MODEL_SOURCE=gpt-oss:20b
GPTOSS_LITE_MODEL_PROFILE=gpt-oss-20b
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_KEEP_ALIVE=15m
LOCAL_LLM_API_KEY=local-lab
# Model exposed to OpenHands. Keep this explicit so changing the Ollama model
# cannot silently leave the shell connected to a different candidate.
OPENHANDS_MODEL_PROFILE=gpt-oss-120b

# Fill these from the rental order before paid tests. The summary uses them only
# for an estimated active-run compute cost; the provider invoice remains authoritative.
SERVER_HOURLY_PRICE=
COST_CURRENCY=USD

POSTGRES_DB=guard_erp
POSTGRES_USER=guard_erp
POSTGRES_PASSWORD=local-lab-only

# Pin these before the paid run if newer releases appear.
OLLAMA_IMAGE=ollama/ollama:latest
# Exact image used in the recorded OpenHands runs. It bundles agent-server/SDK 1.44.0.
OPENHANDS_IMAGE=ghcr.io/openhands/agent-canvas@sha256:862d1842f7935ff19a252c22260fdeeb47ba0a6fd5b18438a7aa46e1de271d22
